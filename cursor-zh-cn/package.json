{
  "name": "cursor-zh-cn",
  "displayName": "Cursor 汉化 (简体中文)",
  "description": "补充翻译 Cursor 部分对话、设置和按钮文案，支持预览、版本隔离备份与还原。建议搭配中文语言包使用。",
  "version": "2.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cursor",
    "chinese",
    "translation",
    "汉化",
    "中文"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "test": "node --test tools/test.js tools/dynamic.test.js",
    "test:dynamic-integration": "node tools/dynamic-integration.js D:/cursor/resources/app",
    "verify": "node tools/verify.js",
    "package": "vsce package --allow-missing-repository --out ../cursor-zh-cn-2.1.0.vsix"
  },
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "cursorZh.apply",
        "title": "应用汉化 (Apply Chinese Translation)",
        "category": "Cursor 汉化"
      },
      {
        "command": "cursorZh.restore",
        "title": "还原英文 (Restore Original)",
        "category": "Cursor 汉化"
      },
      {
        "command": "cursorZh.status",
        "title": "查看汉化状态 (Show Status)",
        "category": "Cursor 汉化"
      },
      {
        "command": "cursorZh.preview",
        "title": "预览汉化 (Preview Translation)",
        "category": "Cursor 汉化"
      },
      {
        "command": "cursorZh.languagePack",
        "title": "安装基础中文语言包 (Chinese Language Pack)",
        "category": "Cursor 汉化"
      },
      {
        "command": "cursorZh.help",
        "title": "使用说明 (Help)",
        "category": "Cursor 汉化"
      }
    ],
    "configuration": {
      "title": "Cursor 汉化",
      "properties": {
        "cursorZh.appRoot": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "通常留空自动识别。识别失败时填写 Cursor 的 resources/app 绝对路径。"
        },
        "cursorZh.dictionaryFile": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "自定义词典文件路径（JSON，格式为 {\"English\": \"中文\"}）。留空则使用扩展自带的词典。"
        },
        "cursorZh.includeHardcoded": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "翻译 Cursor 界面脚本中明确用于标签、标题、占位提示等的词典文案。会修改安装文件并建立备份。"
        }
      }
    }
  },
  "dependencies": {
    "acorn": "8.15.0"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "jsdom": "30.1.3"
  }
}
